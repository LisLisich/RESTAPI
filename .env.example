PROJECT_ROOT=.

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
ALLOWED_ORIGINS=http://localhost:5050,null

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TIMEOUT=10s

LOGGER_LEVEL=DEBUG

TIME_ZONE=UTC

# Base64 от 64-байтного Ed25519 private key. Не коммить реальное значение.
JWT_ED25519_PRIVATE_KEY=

YOOKASSA_ENABLED=false
YOOKASSA_API_URL=https://api.yookassa.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://localhost/payments/return

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=https://localhost/api/v2/auth/google/callback

DOMAIN=localhost
IMAGE_TAG=latest
